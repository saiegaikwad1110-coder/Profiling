if __name__ == "__main__":
    # Graph with 4 vertices and weighted edges
    edges = [
        (0, 1, 10),
        (0, 2, 6),
        (0, 3, 5),
        (1, 3, 15),
        (2, 3, 4)
    ]

    mst, cost = kruskal(4, edges)
    print("MST edges:", mst)
    print("Total cost:", cost)